#!/usr/bin/env python3
"""A stand-in for the `claude` command, used only by check_setup.py: with it, the notebooks run from first
cell to last and no text goes to a model.

It answers only the two print-mode calls that the kit's model.py makes; any other use (an interactive coding
agent) exits 3. Replies: a file in $CLAUDE_STUB_REPLIES named <key>.<n>.txt (the n-th call for that note, from 1)
or <key>.txt, where <key> is the note's number ("0147") or, with no number, the first 12 hex of the note text's
sha1. In function mode the file holds {"text": ..., "calls": [...]}. With no file, a reply is made from the note:
the five fields, phrased a little differently on each call, as a sampled reply is; a note with no amount gets
null under a schema and "None stated" without one. $CLAUDE_STUB_STATE (default: $TMPDIR/claude-stub-state)
counts the calls for each note.
"""
import hashlib, json, os, pathlib, re, sys

args = sys.argv[1:]
if "-p" not in args and "--print" not in args:
    sys.stderr.write("stub claude: only model.py's print-mode calls are answered; no real agent runs here\n")
    sys.exit(3)


def opt(name):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None


note = args[-1]
system = opt("--system-prompt") or ""
schema = opt("--json-schema")
mcp = opt("--mcp-config")
fmt = opt("--output-format") or "text"
state = pathlib.Path(os.environ.get("CLAUDE_STUB_STATE") or (pathlib.Path(os.environ.get("TMPDIR", "/tmp")) / "claude-stub-state"))
state.mkdir(parents=True, exist_ok=True)
m = re.search(r"Note (\d{4})", note)
key = m.group(1) if m else hashlib.sha1(note.encode()).hexdigest()[:12]
counter = state / f"count-{key}-{hashlib.sha1((system + str(schema) + str(bool(mcp))).encode()).hexdigest()[:8]}"
n = int(counter.read_text()) + 1 if counter.exists() else 1
counter.write_text(str(n))


def canned():
    folder = os.environ.get("CLAUDE_STUB_REPLIES")
    if not folder:
        return None
    for name in (f"{key}.{n}.txt", f"{key}.txt"):
        p = pathlib.Path(folder) / name
        if p.exists():
            return p.read_text()
    return None


def fields():
    year = re.search(r"Tax year (\d{4})", note)
    form = re.search(r"Form ([0-9A-Z-]+)", note)
    amount = re.search(r"by ([\d,]+)\b", note) or re.search(r"\$([\d,]+)", note)
    sentences = [s.strip() for s in re.split(r"(?<=\.)\s+", note) if s.strip()]
    body = [s for s in sentences if not re.match(r"(Note \d|Synthetic|Tax year)", s)]
    issue = (body[0] if body else "Unclear issue").rstrip(".")
    action = (body[-1] if len(body) > 1 else "None").rstrip(".")
    variants = [issue, issue.split(",")[0].split(" by ")[0], "Issue: " + issue[0].lower() + issue[1:]]
    out = {"tax_year": int(year.group(1)) if year else None, "form": form.group(1) if form else "",
           "issue": variants[(n - 1) % len(variants)][:120],
           "amount_in_question": int(amount.group(1).replace(",", "")) if amount else (None if schema else "None stated"),
           "next_action": action if n % 2 else "Next: " + action[0].lower() + action[1:]}
    return out


reply = canned()
if mcp:
    if reply is None:
        served = json.loads(mcp)["mcpServers"]["kit"]["args"][-1]
        functions = json.loads(pathlib.Path(served).read_text())
        f = fields()
        calls = []
        if functions:
            fn = functions[0]
            props = fn.get("input_schema", {}).get("properties", {})
            arguments = {k: f.get(k, f"<{k}>") for k in props}
            calls = [{"name": fn["name"], "arguments": arguments}]
        reply = json.dumps({"text": "", "calls": calls})
    data = json.loads(reply)
    content = ([{"type": "text", "text": data["text"]}] if data.get("text") else []) + [
        {"type": "tool_use", "id": f"stub{i}", "name": f"mcp__kit__{c['name']}", "input": c["arguments"]}
        for i, c in enumerate(data.get("calls", []))]
    print(json.dumps({"type": "system", "subtype": "init"}))
    print(json.dumps({"type": "assistant", "message": {"content": content}}))
    if data.get("calls"):
        print(json.dumps({"type": "user", "message": {"content": []}}))
    print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": data.get("text", "")}))
else:
    if reply is None:
        reply = json.dumps(fields())
    if fmt == "json":
        print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": reply}))
    else:
        print(reply)
