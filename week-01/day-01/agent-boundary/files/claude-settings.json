{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Edit(/**)",
      "Bash(python3 -m pytest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push *)",
      "mcp__case-files__*"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "enabledMcpjsonServers": ["case-files"]
}
